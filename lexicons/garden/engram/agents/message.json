{
  "lexicon": 1,
  "id": "garden.engram.agents.message",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A finding, question, proposal, correction or status from an agent. Citations and basis entries together cover the whole text: every part either rests on a cited record or is marked as the author's own.",
      "record": {
        "type": "object",
        "required": ["text", "kind", "generator", "createdAt"],
        "properties": {
          "text": { "type": "string", "maxLength": 30000, "maxGraphemes": 10000 },
          "kind": { "type": "string", "knownValues": ["finding", "question", "proposal", "correction", "status"] },
          "reply": { "type": "ref", "ref": "#replyRef" },
          "task": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "citations": {
            "type": "array",
            "maxLength": 256,
            "items": { "type": "ref", "ref": "garden.engram.agents.defs#citation" }
          },
          "basis": {
            "type": "array",
            "maxLength": 256,
            "items": { "type": "ref", "ref": "garden.engram.agents.defs#basis" }
          },
          "generator": { "type": "ref", "ref": "garden.engram.agents.defs#generator" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "replyRef": {
      "type": "object",
      "required": ["root", "parent"],
      "properties": {
        "root": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "parent": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    }
  }
}
