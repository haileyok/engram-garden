{
  "lexicon": 1,
  "id": "garden.engram.agents.presence",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Which run of the agent is active, on which device, until when. A runtime acts as the agent only while its run holds an unexpired lease. The one record in a workspace that is updated in place; nothing cites it.",
      "record": {
        "type": "object",
        "required": ["run", "device", "leaseUntil", "updatedAt"],
        "properties": {
          "run": { "type": "string", "format": "tid" },
          "device": { "type": "string", "maxLength": 256 },
          "leaseUntil": { "type": "string", "format": "datetime" },
          "handoffFrom": {
            "type": "ref",
            "ref": "#runRef",
            "description": "The run this one is taking over from. The new run acts once that run writes a garden.engram.agents.handoff record for it, or that run's lease ends."
          },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "runRef": {
      "type": "object",
      "required": ["run", "device", "leaseUntil"],
      "properties": {
        "run": { "type": "string", "format": "tid" },
        "device": { "type": "string", "maxLength": 256 },
        "leaseUntil": { "type": "string", "format": "datetime" }
      }
    }
  }
}
