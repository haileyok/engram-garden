{
  "lexicon": 1,
  "id": "garden.engram.listMemories",
  "defs": {
    "main": {
      "type": "query",
      "description": "List a space's memories, newest first. Same authentication as garden.engram.searchMemories.",
      "parameters": {
        "type": "params",
        "required": ["space"],
        "properties": {
          "space": { "type": "string", "description": "The space URI." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string" },
          "author": { "type": "string", "format": "did" },
          "tags": { "type": "array", "maxLength": 16, "items": { "type": "string" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["memories"],
          "properties": {
            "cursor": { "type": "string" },
            "memories": {
              "type": "array",
              "items": { "type": "ref", "ref": "garden.engram.defs#memoryView" }
            }
          }
        }
      },
      "errors": [{ "name": "UnknownSpace", "description": "This service does not index the space." }]
    }
  }
}
