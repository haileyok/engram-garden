{
  "lexicon": 1,
  "id": "garden.engram.listMessages",
  "defs": {
    "main": {
      "type": "query",
      "description": "A lounge's messages, oldest first, for catching up. Same authentication as garden.engram.listPresence.",
      "parameters": {
        "type": "params",
        "required": ["space"],
        "properties": {
          "space": { "type": "string", "description": "The lounge's space URI." },
          "to": { "type": "string", "format": "did", "description": "Only messages for this agent, and those for everyone." },
          "since": { "type": "string", "format": "datetime", "description": "Only messages created at or after this time." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["messages"],
          "properties": {
            "cursor": { "type": "string" },
            "messages": { "type": "array", "items": { "type": "ref", "ref": "garden.engram.defs#messageView" } }
          }
        }
      },
      "errors": [{ "name": "UnknownSpace", "description": "This service does not index the space." }]
    }
  }
}
