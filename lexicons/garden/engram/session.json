{
  "lexicon": 1,
  "id": "garden.engram.session",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "One agent session in an archive, written by the session's own identity: where the work stands, and its transcript. The record key is the harness's session ID. Rewritten as the session goes on. chunks name the transcript's bytes, complete JSONL lines in blobs, oldest first; head says how far they go.",
      "record": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "updatedAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "maxLength": 128,
            "description": "The harness's session ID: the same as the record key."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "description": "A short name for the work."
          },
          "summary": {
            "type": "string",
            "maxLength": 50000,
            "description": "Markdown: the goal, what's done, what's in progress, decisions, and the next steps."
          },
          "status": {
            "type": "string",
            "knownValues": [
              "active",
              "ended"
            ],
            "description": "Whether the session was still going when this was written."
          },
          "kind": {
            "type": "string",
            "knownValues": [
              "session",
              "subagent"
            ],
            "description": "A top-level session, or a subagent another agent started."
          },
          "parent": {
            "type": "string",
            "format": "did",
            "description": "The agent that started this one, for a subagent."
          },
          "repo": {
            "type": "string",
            "maxLength": 2000,
            "description": "The repository, as its remote URL."
          },
          "branch": {
            "type": "string",
            "maxLength": 256
          },
          "cwd": {
            "type": "string",
            "maxLength": 2000,
            "description": "The working directory, on the machine."
          },
          "machine": {
            "type": "string",
            "maxLength": 256,
            "description": "The machine's host name."
          },
          "harness": {
            "type": "string",
            "maxLength": 64,
            "description": "The agent harness, such as pi."
          },
          "model": {
            "type": "string",
            "maxLength": 256
          },
          "gitHead": {
            "type": "string",
            "maxLength": 128,
            "description": "The commit the working tree was on: resuming needs the same code."
          },
          "gitDirty": {
            "type": "boolean",
            "description": "Whether the working tree had uncommitted changes."
          },
          "startedAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "head": {
            "type": "object",
            "description": "How far the stored transcript goes.",
            "properties": {
              "entryId": {
                "type": "string",
                "maxLength": 256,
                "description": "The last transcript entry stored."
              },
              "entries": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "The whole transcript's size."
              }
            }
          },
          "chunks": {
            "type": "array",
            "maxLength": 2000,
            "description": "The transcript's chunks, oldest first.",
            "items": {
              "type": "ref",
              "ref": "#chunk"
            }
          }
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "blob",
        "bytes"
      ],
      "description": "Complete transcript lines in a blob whose CID is the digest of its bytes: at most 3 MiB, unless a single line is longer (up to 8 MiB).",
      "properties": {
        "blob": {
          "type": "blob",
          "accept": [
            "application/octet-stream"
          ],
          "maxSize": 8388608
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "firstEntry": {
          "type": "string",
          "maxLength": 256
        },
        "lastEntry": {
          "type": "string",
          "maxLength": 256
        }
      }
    }
  }
}
